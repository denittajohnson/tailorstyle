<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template t-name="tailorstyle_website.user_login">
        <div class="container d-flex justify-content-center align-items-center" style="min-height:80vh;">
            <div class="card p-4" style="width: 350px;">
                
                <h3 class="text-center mb-4">Login to View Your Orders</h3>
                <form t-att-action="'/my_orders/login'" method="post">
                    <!-- CSRF token -->
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="form-group mb-3">
                        <input type="text" name="phone" class="form-control" maxlength="10"
                               pattern="\d{10}" title="Enter 10-digit phone number"
                               placeholder="Phone number" required="required"/>
                    </div>

                    <div class="form-group mb-3">
                        <input type="password" name="password" class="form-control"
                               placeholder="Password" required="required"/>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Login</button>
                    
                </form>
            </div>
        </div>
    </template>
</odoo>
