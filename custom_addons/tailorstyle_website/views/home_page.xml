<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template t-name="tailorstyle_website.home_page">
        <div class="home-banner">

            <!-- Top right navigation -->
            <div class="home-nav">
                <a href="/collections" class="nav-link">Collections</a>
                <a href="/my_orders" class="nav-link">My Orders</a>
                <a href="/register" class="register-btn">Register</a>
            </div>

            <!-- Site Name + Quote -->
            <div class="site-title-box">
                <h1 class="site-title">TailorStyle</h1>
                <p class="site-quote">your ideas tailored into wearable perfection.</p>
            </div>

            <!-- Footer -->
            <footer class="home-footer">
                <p>© 2025 TailorStyle. All rights reserved.</p>
            </footer>
        </div>

        <!-- CSS -->
        <style>
            body {
                overflow-x: hidden;
                height: 100%;
            }

            .home-banner {
                background-image: url('/tailorstyle_website/static/src/img/backim.jpg');
                height: 100vh;
                width: 100%;
                background-size: cover;
                background-position: center center;
                background-repeat: no-repeat;
                background-attachment: fixed;
                position: relative;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            /* NAV BAR */
            .home-nav {
                position: absolute;
                top: 20px;
                right: 30px;
                display: flex;
                gap: 27px;
                align-items: center;
            }

            .home-nav .nav-link {
                color: black;
                font-size: 15px;
                text-decoration: none;
                font-weight: 500;
            }

            .home-nav .register-btn {
                background-color: rgba(159, 91, 13, 0.6);
                color: white;
                padding: 10px 20px;
                border-radius: 7px;
                font-weight: bold;
                text-decoration: none;
            }

            /* SITE TITLE + QUOTE BOX */
            .site-title-box {
                position: absolute;
                top: 95px;       /* distance below nav links */
                right: 50px;
                text-align: right;
                max-width: 350px;
            }

            .site-title {
                font-family: 'Brush Script MT', cursive;
                font-size: 6rem;
                font-weight: bold;
                color: #4da6ff; /* glowing blue */
                text-shadow: 0 0 10px #4da6ff, 0 0 20px #1e90ff;
                margin-bottom: 5px;
            }

            .site-quote {
                color: black;
                font-size: 0.8rem;
                font-weight: 500;
                margin-top: 10px;   /* spacing below title */
            }

            /* FOOTER */
            .home-footer {
                position: absolute;
                bottom: 10px;
                width: 100%;
                text-align: center;
                color: black;
                font-size: 0.9rem;
            }

            /* TABLET VIEW */
            @media (max-width: 1024px) {
                .site-title {
                    font-size: 3.5rem;
                }
                .site-quote {
                    font-size: 1.1rem;
                }
            }

            /* MOBILE */
            @media (max-width: 768px) {

                .home-banner {
                    background-attachment: scroll;
                    background-size: contain;
                    background-color: #ffffff;
                    height: 100vh;
                }

                .home-nav {
                    flex-wrap: wrap;
                    top: 15px;
                    right: 10px;
                    gap: 10px;
                }

                .site-title-box {
                    top: 100px;
                    right: 15px;
                    max-width: 250px;
                }

                .site-title {
                    font-size: 2.8rem;
                }

                .site-quote {
                    font-size: 1rem;
                }
            }

            /* VERY SMALL MOBILE */
            @media (max-width: 480px) {

                .site-title-box {
                    top: 105px;
                    right: 20px;
                    max-width: 200px;
                }

                .site-title {
                    font-size: 2.2rem;
                }

                .site-quote {
                    font-size: 0.9rem;
                }
            }

        </style>
    </template>
</odoo>

