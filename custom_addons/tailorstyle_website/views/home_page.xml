<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template t-name="tailorstyle_website.home_page">
        <div class="home-banner">
            
            <!-- Top right navigation -->
            <div class="home-nav">
                <a href="/collections" class="nav-link">Collections</a>
                <a href="/my_orders" class="nav-link">My Orders</a>
                <a href="/register" class="register-btn">Register</a>
            </div>

            <!-- Footer -->
            <footer class="home-footer">
                <p>© 2025 TailorStyle. All rights reserved.</p>
            </footer>
        </div>

        <!-- CSS -->
        <style>
            body {
                overflow-x: hidden;
                height: 100%;
    
            }

            /* Home banner background */
            .home-banner {
                background-image: url('/tailorstyle_website/static/src/img/bng.jpg');
                height: 100vh;
                width: 100%;
                background-size: cover;               /* FULL-SCREEN FIT */
                background-position: center center;   /* KEEP CENTER VISIBLE */
                background-repeat: no-repeat;
                background-attachment: fixed;         /* MAKES IT PERFECT IN LAPTOP */
                position: relative;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }


            /* Navigation */
            .home-nav {
                position: absolute;
                top: 20px;
                right: 30px;
                display: flex;
                gap: 27px;
                align-items: center;
            }

            .home-nav .nav-link {
                color: black;
                font-size: 15px;
                text-decoration: none;
                font-weight: 500;
            }

            .home-nav .register-btn {
                background-color: rgba(208, 182, 16, 0.6);
                color: white;
                padding: 10px 20px;
                border-radius: 7px;
                font-weight: bold;
                text-decoration: none;
            }

            /* Centered title and quote */
            .home-center {
                height: 100%;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                text-align: center;
                color: white;
            }

            .home-center h1 {
                font-size: 5rem;
                font-family: 'Brush Script MT', cursive;
                margin-bottom: 20px;
                text-shadow: 2px 2px 8px rgba(0,0,0,0.6);
            }

            .home-center p {
                font-size: 1.4rem;
                max-width: 600px;
                text-shadow: 1px 1px 5px rgba(0,0,0,0.6);
            }

            /* Footer */
            .home-footer {
                position: absolute;
                bottom: 10px;
                width: 100%;
                text-align: center;
                color: black;
                font-size: 0.9rem;
            }

            /* Responsive styles */
            @media (max-width: 1024px) {
                .home-center h1 {
                    font-size: 4rem;
                }
                .home-center p {
                    font-size: 1.5rem;
                    max-width: 80%;
                }
                .home-nav .nav-link {
                    font-size: 16px;
                }
                .home-nav .register-btn {
                    padding: 8px 15px;
                    font-size: 14px;
                }
            }

            @media (max-width: 768px) {
                
                .home-banner {
                    background-attachment: scroll; /* mobile safe */
                    background-size: contain;        /* keep full fit */
                    background-position: top-center;
                    background-repeat: no-repeat;
                    background-color: #ffffffff;      /* fills empty area below */
                    height: 100vh;
                }

                .home-nav {
                    flex-direction: row; /* keep in a row */
                    flex-wrap: wrap;
                    top: 10px;
                    right: 10px;
                    gap: 10px;
                }
                .home-center h1 {
                    font-size: 3rem;
                }
                .home-center p {
                    font-size: 1.2rem;
                }
            }

            @media (max-width: 480px) {
                .home-banner {
                    background-attachment: scroll; /* mobile safe */
                    background-size: contain;        /* keep full fit */
                    background-position: top-center;
                    background-repeat: no-repeat;
                    background-color: #ffffffff;      /* fills empty area below */
                    height: 100vh;
                }

                .home-nav {
                    flex-direction: row; /* keep in a row */
                    flex-wrap: wrap;
                    top: 16px;
                    right: 10px;
                    gap: 10px;
                }
                .home-center h1 {
                    font-size: 2.2rem;
                }
                .home-center p {
                    font-size: 1rem;
                }
                .home-nav .nav-link {
                    font-size: 14px;
                }
                .home-nav .register-btn {
                    padding: 6px 12px;
                    font-size: 12px;
                }
            }
        </style>
    </template>
</odoo>



